# =============================================================
# PROPERTY_CRAWL — Git ignore rules
# =============================================================
# Without this, node_modules + .next + the 360MB perfectproperty
# ui.tar would all be tracked. Do not commit a .gitignore-less repo.

# --- Dependencies ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# --- Build output ---
.next/
.next-discovery-preview/
.next-sources-verify/
.next-verify/
out/
dist/
build/
*.tsbuildinfo

# --- Local env / secrets ---
.env
.env.local
.env.*.local
*.pem
.secrets/

# --- Test output ---
test_output/
playwright-report/
playwright/.cache/
.coverage
.nyc_output/

# --- Python build / cache (used by scripts/crawlers/scrapling_extract.py) ---
__pycache__/
*.pyc
*.pyo
*.pyd

# --- OS noise ---
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
.cache/

# --- Logs ---
*.log
*.err
logs/

# --- PWA / puter runtime artifacts ---
.puter/
.playwright/

# --- Backups / large archives ---
# perfectproperty ui.tar was 343MB of build artifacts + screenshots.
# If you really need it, store it in S3 / a release bucket, not git.
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar

# --- Design assets / uploads ---
# upload/ has 50 files (screenshots, blueprint, raw pasted images)
# that are not part of the runtime. Add explicit allow-rules below
# if any of them should be in git.
upload/

# --- Misc ---
*.local
.turbo/
.vercel/

# --- v0 PWA backup (retired UI; kept locally for one-cycle rollback) ---
.v0_backup/

# --- One-shot probes / scratch (left on disk, never committed) ---
*.bak
*.bak2
*.bak3
full-diff.txt
sp-diff.txt
test/smoke-*.js

# --- Video-creator task plumbing (H3 submissions land under videos/) ---
video-creater-args.json
video-creater-prompt.txt
video-creater-query.json
video-creater-submit.json
video-creater-task-*.json
videos/

# --- Auto-regenerated runtime state (managed by the listed tools) ---
.agents/skills-index.json            # generated by scripts/gen-skills-index.js
.agents/skills/agent-verification/SKILL.md  # auto-edited by skills indexer
.dsh-project-memory/                 # runtime shard store for the dsh tool
.kilo/mcp.json                       # auto-edited by the kilo MCP registry
