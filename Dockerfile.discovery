# Dedicated Next.js image for the discovery compose stack. The existing
# Dockerfile remains API-focused and is intentionally untouched.
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

FROM deps AS builder
WORKDIR /app
COPY . .
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3001
USER node
COPY --chown=node:node --from=builder /app ./
EXPOSE 3001
CMD ["npm", "run", "start"]
