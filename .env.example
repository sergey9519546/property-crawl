# =============================================================
# PROPERTY_CRAWL — Environment variables
# =============================================================
# Copy to .env.local and fill in. .env.local is gitignored.
# For production, set these in your host's dashboard (Netlify,
# Cloudflare, Fly.io, etc.) — do NOT commit secrets.
# =============================================================

# --- Server runtime ---
# Port the v1 Node server listens on. Default: 3000
PORT=3000

# URL used by the canonical Next.js UI to reach the listing API.
# The local default already points here; set it explicitly when deployed.
PROPERTY_API_URL=http://localhost:3000

# Socket-level API protection (requests/minute). When Next proxies traffic,
# this is a shared backend budget. Deploy behind a trusted edge with per-client
# limits; arbitrary X-Forwarded-For headers are intentionally not trusted.
# PROPERTY_API_RATE_LIMIT=120

# Optional durable local observations collected by scripts/collect-source.js.
# Kept separate from bundled demos. Restart the API after a collection.
# PROPERTY_LIVE_CACHE_PATH=.cache/live-listings.json

# Node environment. 'development' enables verbose logs, 'production' locks down.
NODE_ENV=development

# Required only for the server-side Google Street View fallback on verified
# source records that have no usable publisher photo. Never expose this as a
# NEXT_PUBLIC_* variable. In Google Cloud, restrict the key to the Street View
# Static API (and Geocoding API only if the strict rooftop fallback is enabled),
# then apply a server-IP restriction appropriate for the deployment.
# GOOGLE_MAPS_API_KEY=

# Optional: use a separately restricted server key for address geocoding. When
# omitted, GOOGLE_MAPS_API_KEY is used. Only a single non-partial ROOFTOP match
# whose street number, route, state, ZIP, and country agree is accepted.
# GOOGLE_GEOCODING_API_KEY=

# Street View matching is deliberately conservative. Metadata must resolve to
# an outdoor panorama within this radius and within the stricter max distance.
# GOOGLE_STREETVIEW_RADIUS_METERS=50
# GOOGLE_STREETVIEW_MAX_DISTANCE_METERS=35
# GOOGLE_STREETVIEW_TIMEOUT_MS=5000
# GOOGLE_STREETVIEW_FOV=80
# GOOGLE_STREETVIEW_PITCH=0

# Quota protection for the same-origin property-image proxy.
# PROPERTY_IMAGE_RATE_LIMIT=30
# PROPERTY_IMAGE_RATE_WINDOW_MS=60000
# PROPERTY_IMAGE_CONCURRENCY=3
# PROPERTY_IMAGE_MAX_QUEUE=20
# GOOGLE_STREETVIEW_CIRCUIT_THRESHOLD=3
# GOOGLE_STREETVIEW_CIRCUIT_COOLDOWN_MS=60000
# GOOGLE_GEOCODING_CIRCUIT_THRESHOLD=3
# GOOGLE_GEOCODING_CIRCUIT_COOLDOWN_MS=60000

# --- Database ---
# Optional. If unset, server/db/client.js falls back to in-memory provider
# seeded from data.js. Set to a Postgres+PostGIS URL to enable persistence.
# Format: postgres://user:pass@host:5432/dbname
# DATABASE_URL=postgres://localhost:5432/property_crawl

# --- AI (server-side fallback) ---
# Optional server-side provider. Leave unset to fail closed.
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The beta newsletter control stores a local preview only. Add a real email
# provider and documented consent/retention behavior before enabling delivery.

# --- Scrapers (Phase 1+ only) ---
# Required to trigger on-demand scraper runs through the admin endpoint.
# SCRAPER_ADMIN_TOKEN=
# SCRAPER_BACKGROUND_ENABLED=0
# Source Radar uses the same operator token for collection and evidence review.
# Local durable stores; mount .cache on persistent storage in a container.
# PROPERTY_OBSERVATIONS_PATH=.cache/source-observations.json
# PROPERTY_SOURCE_INTAKE_PATH=.cache/source-intake.json
# PROPERTY_HUNTS_PATH=.cache/saved-hunts.json
# CENSUS_API_KEY=
# SERVICELINK_MAX_PAGES=1
# SERVICELINK_PAGE_SIZE=25
# PROPERTY_LIVE_CACHE_PATH=.cache/live-listings.json
# HUD_STATES=OH,NJ,PA
# HUD_MAX_STATES=52
# HUD_MAX_PAGES_PER_STATE=3
# HUD_PAGE_SIZE=50
# HUD_STATE_CONCURRENCY=2

# Optional. Press-association email alerts per Hack #1 of docs/STRATEGY.md.
# Used by server/scrapers/email-ingest.js (not yet built).
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=alerts@yourdomain.com
# IMAP_PASS=xxxxxxxxxxxxxxxxxxxxxxxx
# IMAP_TLS=true

# --- Observability (post-launch) ---
# Optional. Sentry DSN for client + server error reporting.
# SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxx@sentry.io/xxxxxxx
