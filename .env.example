# =============================================================
# PROPERTY_CRAWL — Environment variables
# =============================================================
# Copy to .env.local and fill in. .env.local is gitignored.
# For production, set these in your host's dashboard (Netlify,
# Cloudflare, Fly.io, etc.) — do NOT commit secrets.
# =============================================================

# --- Server runtime ---
# Port the v1 Node server listens on. Default: 3000
PORT=3000

# Node environment. 'development' enables verbose logs, 'production' locks down.
NODE_ENV=development

# --- Database ---
# Optional. If unset, server/db/client.js falls back to in-memory provider
# seeded from data.js. Set to a Postgres+PostGIS URL to enable persistence.
# Format: postgres://user:pass@host:5432/dbname
# DATABASE_URL=postgres://localhost:5432/property_crawl

# --- Puter.js (v0 AI + persistence runtime) ---
# v0 uses builder.puter.com defaults in development. For production,
# register a Puter app at https://puter.com/app-builder and set these
# so you have a stable app ID + rate-limit visibility.
# PUTER_APP_ID=app-xxxxxxxxxxxx
# PUTER_API_KEY=puter_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- AI (server-side fallback) ---
# v0 uses Puter's GPT-4o-mini for the in-browser AI. The v1 server's
# AI router can fall back to direct OpenAI if Puter is unavailable.
# Optional — leave unset to fail closed.
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Newsletter (Formspree) ---
# The form action URL from your Formspree form. v0 footer form posts here.
# Free tier: 50 submissions/month. Set up at https://formspree.io
# NEXT_PUBLIC_NEWSLETTER_ENDPOINT=https://formspree.io/f/xxxxxxxxxxxx

# --- Scrapers (Phase 1+ only) ---
# Optional. Press-association email alerts per Hack #1 of docs/STRATEGY.md.
# Used by server/scrapers/email-ingest.js (not yet built).
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=alerts@yourdomain.com
# IMAP_PASS=xxxxxxxxxxxxxxxxxxxxxxxx
# IMAP_TLS=true

# --- Observability (post-launch) ---
# Optional. Sentry DSN for client + server error reporting.
# SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxx@sentry.io/xxxxxxx
